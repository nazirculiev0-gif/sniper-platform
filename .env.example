# PostgreSQL. Локально можно поднять через docker:
# docker run --name sniper-db -e POSTGRES_PASSWORD=postgres -p 5432:5432 -d postgres:16
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/sniper?schema=public"

# Для продакшна (Neon) строка подключения выглядит так, с обязательным sslmode:
# DATABASE_URL="postgresql://user:pass@ep-xxxx.region.aws.neon.tech/sniper?sslmode=require"

# Сгенерировать: openssl rand -base64 32
NEXTAUTH_SECRET="change-me"
NEXTAUTH_URL="http://localhost:3000"
# В продакшне: NEXTAUTH_URL="https://ваш-домен.vercel.app"
